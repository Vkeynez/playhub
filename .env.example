# Server environment (apps/server). ARCHITECTURE §5.5.
#
# This file documents every variable and holds NO real values. Copy it to `.env` for local runs
# (.env is gitignored). In production the values live only in the Render dashboard: render.yaml
# declares them, docs/SETUP.md step 3 says where each comes from.
#
# The server parses this with zod at boot. Missing required values -> exit(1) with a clear message.
# An empty optional value counts as unset, and the server logs which features are disabled.

# --- Required -------------------------------------------------------------------------------

# Neon POOLED connection string (host ends in -pooler; PgBouncer, transaction mode). All app
# traffic. No SET, LISTEN/NOTIFY, session advisory locks or SQL PREPARE over this URL.
# Local: your local Postgres 17 (for example the embedded-postgres instance), as
#   postgres://<user>:<password>@localhost:<port>/<db>
DATABASE_URL=

# Neon DIRECT connection string (same host without -pooler). Migrations only, on a dedicated
# pg.Client holding a session advisory lock. Locally it can equal DATABASE_URL.
DATABASE_URL_DIRECT=

# HS256 signing key for 15-minute access JWTs. Production: generated by Render
# (render.yaml generateValue). Local: any long random string, e.g. `openssl rand -base64 32`.
JWT_SECRET=

# HMAC key for storing refresh tokens hashed. Rotating it invalidates every refresh token, which
# orphans every guest account (a guest has no other credential). Never rotate casually.
REFRESH_SECRET=

# HMAC key that derives the idempotent successor of a rotated refresh token (ARCHITECTURE §7).
# Same warning as REFRESH_SECRET.
K_ROTATE=

# Comma-separated list of allowed web origins, scheme included, no trailing slash.
# Production: https://<web>.onrender.com (plus the custom domain, if any).
# Local: http://localhost:8081
CORS_ORIGINS=

# Bearer token for /ops/* (reload, bench, quiz import). Production: generated by Render.
ADMIN_TOKEN=

# --- Optional: the first deploy works without these -------------------------------------------

# Comma-separated Google OAuth client IDs accepted as the ID-token audience (the Web client ID,
# plus the Android client IDs). Client IDs are not secrets. Unset -> the Google routes answer
# 503 google_not_configured and guests keep working.
GOOGLE_CLIENT_IDS=

# Expo access token for sending push notifications (Phase 1). Unset -> push stays off.
EXPO_ACCESS_TOKEN=

# Sentry DSN (Phase 5, OPEN_QUESTIONS I1). Unset -> Sentry is a no-op.
SENTRY_DSN=

# Comma-separated user IDs (UUIDs) that can see dev-only games (games.status = dev).
DEV_USER_IDS=

# Oldest client protocol version the server accepts in `hello` (ARCHITECTURE §4.4).
# Unset -> the server's built-in minimum.
MIN_PROTOCOL_VERSION=

# --- Settings with defaults ----------------------------------------------------------------

# bearer (default) | cookie. Cookie mode needs a custom domain (ARCHITECTURE §7).
AUTH_TRANSPORT=bearer

# Port to bind. Render sets PORT itself (10000); the server binds 0.0.0.0:$PORT.
PORT=3000

# pino log level: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# How many reverse-proxy hops to trust for the client IP (rate limits, ARCHITECTURE §5.7).
# 0 = trust none. On Render, set it to the hop count measured with GET /ops/headers.
TRUST_PROXY_HOPS=0

# --- Tests only (not read by the server) ---------------------------------------------------

# Postgres for integration tests instead of embedded-postgres. CI points it at its postgres:17
# service container (.github/workflows/ci.yml).
# TEST_DATABASE_URL=

# Simulated matches per game in the contract harness: 100 locally, 1000 in CI.
# CONTRACT_SIM_MATCHES=100

# --- Set by Render at runtime; never set these yourself ---------------------------------------
# RENDER_GIT_COMMIT     commit SHA of the running deploy; reported as buildSha on /health
# RENDER_EXTERNAL_URL   public URL of the service
#
# render.yaml also sets NODE_VERSION (24.21.0, same as .nvmrc) and COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# for the build; the server doesn't read them.
#
# Do not put NODE_ENV=production in the Render env: env vars also apply to the build, and pnpm
# then skips devDependencies (esbuild, turbo).
