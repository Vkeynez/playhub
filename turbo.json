{
  "$schema": "https://turborepo.com/schema.json",
  "remoteCache": { "enabled": false },
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": {},
    "test": { "dependsOn": ["build"], "env": ["CONTRACT_SIM_MATCHES", "TEST_DATABASE_URL"] },
    "lint": {}
  }
}
